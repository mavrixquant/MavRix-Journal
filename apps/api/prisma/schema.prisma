generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String?
  firstName         String?
  lastName          String?
  emailVerified     Boolean   @default(false)
  verifyToken       String?   @unique
  verifyTokenExpiry DateTime?
  resetToken        String?   @unique
  resetTokenExpiry  DateTime?
  googleId          String?   @unique
  photoUrl          String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  role String @default("user")

  isBanned     Boolean   @default(false)
  bannedAt     DateTime?
  bannedReason String?
  bannedBy     String?

  lastLoginAt DateTime?

  tokenVersion Int @default(0)

  accounts      Account[]
  layouts       UserLayout[]
  strategies    Strategy[]
  conversations ConversationParticipant[]
  messages      Message[]

  @@index([role])
  @@index([isBanned])
  @@map("users")
}

model Account {
  id              String   @id @default(cuid())
  userId          String
  name            String
  balance         Float
  currency        String   @default("USD")
  type            String   @default("Backtest")
  riskType        String   @default("fixed")
  riskValue       Float?
  riskUnit        String?
  slValue         Float?
  slUnit          String?
  commissionMode  String   @default("none")
  commissionValue Float?
  columnConfigs   Json     @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades Trade[]

  @@index([userId])
  @@map("accounts")
}

model Trade {
  id         String  @id @default(cuid())
  accountId  String
  strategyId String?
  tradeId    String
  date       String
  entryTime  String
  exitTime   String
  direction  String
  symbol     String  @default("")

  mae      Float?
  mfe      Float?
  slPoints Float?

  entryPrice Float?
  takeProfit Float?
  stopLoss   Float?

  pnl       Float    @default(0)
  quantity  Float?
  notes     String   @default("")
  dynamic   Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account  Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  strategy Strategy? @relation(fields: [strategyId], references: [id], onDelete: SetNull)

  @@unique([accountId, tradeId])
  @@index([accountId])
  @@index([accountId, date])
  @@index([strategyId])
  @@map("trades")
}

model UserLayout {
  id        String   @id @default(cuid())
  userId    String
  name      String
  layout    Json
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_layouts")
}

model EconomicEvent {
  id              String    @id @default(cuid())
  externalId      String    @unique
  eventId         String?
  date            String
  timeUtc         String
  dateTimeUtc     DateTime
  period          DateTime?
  countryCode     String
  currency        String
  event           String
  impact          String
  eventType       String?
  sector          String?
  unit            String?
  multiplier      String?
  digits          Int?
  actual          String?
  forecast        String?
  previous        String?
  revisedPrevious String?
  revision        Int?
  timeMode        String?
  sourceUrl       String?
  source          String
  fetchedAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([dateTimeUtc])
  @@index([currency, date])
  @@index([impact, date])
  @@index([eventId])
  @@map("economic_events")
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actorEmail String
  action     String
  targetType String?
  targetId   String?
  metadata   Json     @default("{}")
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("site_settings")
}

model GexDay {
  id        String @id @default(cuid())
  date      String @unique
  levels    Json   @default("[]")
  converted String @default("")

  levelCount Int @default(0)
  blCount    Int @default(0)
  gexCount   Int @default(0)
  otherCount Int @default(0)

  sourceTimezone String @default("Asia/Kolkata")
  uploadedBy     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@map("gex_days")
}

model Strategy {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String   @default("")
  rules       String   @default("")
  status      String   @default("active")
  color       String   @default("#F59E0B")
  direction   String?
  timeframe   String?
  tags        String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades Trade[]

  @@unique([userId, name])
  @@index([userId])
  @@index([userId, status])
  @@map("strategies")
}

// ---------------------------------------------------------------------------
// Chat — Direct Messages (DMs) only.
//
// Read receipts:
//   - Message.deliveredAt — set by the non-sender's device when it receives
//     the message (either via POST /messages/:id/delivered for live SSE
//     delivery, or in bulk by markRead on thread open).
//   - Message.readAt — set when the non-sender opens the conversation
//     (markRead). Also triggers a broadcast to the sender.
//
// Both columns are nullable. For a fresh DM, they're null until the peer's
// device acknowledges. For 1:1 DMs, "the non-sender" is unambiguous — when
// Discussions arrive later, this migrates to a per-user MessageReceipt table.
// ---------------------------------------------------------------------------
model Conversation {
  id              String   @id @default(cuid())
  type            String   @default("dm")
  dmKey           String?  @unique
  lastMessageAt   DateTime @default(now())
  lastMessageText String?
  lastMessageById String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]

  @@index([lastMessageAt])
  @@map("conversations")
}

model ConversationParticipant {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime @default(now())
  lastReadAt     DateTime @default(now())
  lastReadMsgId  String?
  unreadCount    Int      @default(0)
  isPinned       Boolean  @default(false)
  isMuted        Boolean  @default(false)
  isArchived     Boolean  @default(false)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, isArchived])
  @@index([userId, lastReadAt])
  @@map("conversation_participants")
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  replyToId      String?
  createdAt      DateTime  @default(now())
  editedAt       DateTime?
  deletedAt      DateTime?
  deletedForIds  String[]  @default([])
  deliveredAt    DateTime?
  readAt         DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo      Message?     @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Message[]    @relation("MessageReply")

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("messages")
}