
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String?
  firstName         String?
  lastName          String?
  emailVerified     Boolean   @default(false)
  verifyToken       String?   @unique
  verifyTokenExpiry DateTime?
  resetToken        String?   @unique
  resetTokenExpiry  DateTime?
  googleId          String?   @unique
  photoUrl          String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  accounts Account[]
  layouts  UserLayout[]

  @@map("users")
}

model Account {
  id              String   @id @default(cuid())
  userId          String
  name            String
  balance         Float
  currency        String   @default("USD")
  type            String   @default("Backtest")
  riskType        String   @default("fixed")
  riskValue       Float?
  riskUnit        String?
  slValue         Float?
  slUnit          String?
  commissionMode  String   @default("none")
  commissionValue Float?
  columnConfigs   Json     @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades Trade[]

  @@index([userId])
  @@map("accounts")
}

// ---------------------------------------------------------------------------
// Trade
//
// A single Trade model serves BOTH dashboards, but the two dashboards use
// different, non-overlapping field sets:
//
//   Live / Demo (Journal trade logs):
//     date, entryTime, exitTime, direction, symbol,
//     entryPrice, takeProfit, stopLoss, pnl, quantity, notes
//
//   Backtest (Backtester test logs):
//     date, entryTime, exitTime, direction, symbol,
//     mae, mfe, slPoints, pnl, quantity, notes
//
// Fields that belong to the "other" dashboard's shape are stored as NULL.
// This avoids a polymorphic model and keeps a single trade-list endpoint.
//
// slPoints is the resolved stop-loss distance in POINTS. The UI may capture
// it in ticks (account.slUnit === 'ticks'), but the API always stores points.
// ---------------------------------------------------------------------------
model Trade {
  id         String   @id @default(cuid())
  accountId  String
  tradeId    String
  date       String
  entryTime  String
  exitTime   String
  direction  String
  symbol     String   @default("")

  // --- Backtester-only (nullable on Live/Demo trades) ---
  mae        Float?
  mfe        Float?
  slPoints   Float?

  // --- Journal-only (nullable on Backtest trades) ---
  entryPrice Float?
  takeProfit Float?
  stopLoss   Float?

  // --- Common ---
  pnl        Float    @default(0)
  quantity   Float?
  notes      String   @default("")
  dynamic    Json     @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, tradeId])
  @@index([accountId])
  @@index([accountId, date])
  @@map("trades")
}

model UserLayout {
  id        String   @id @default(cuid())
  userId    String
  name      String
  layout    Json
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_layouts")
}

// ---------------------------------------------------------------------------
// Economic Calendar — cached from Biquote (https://biquote.io)
//
// Design notes:
//   - externalId is Biquote's `id` field (e.g. "mql5:900001"). Unique.
//   - eventId is Biquote's `eventId` (e.g. "mql5:840") — the recurring series
//     identifier. Not unique; many rows share one eventId.
//   - actual / forecast / previous / revisedPrevious are stored as String?
//     because Biquote returns null when unpublished and numbers otherwise.
//     String preserves both the null signal and the raw value for display.
//   - multiplier is stored separately from unit so the frontend can decide
//     how to render (e.g. 152000 + "thousands" → "152,000K").
// ---------------------------------------------------------------------------
model EconomicEvent {
  id              String   @id @default(cuid())
  externalId      String   @unique
  eventId         String?
  date            String   // YYYY-MM-DD derived from timeUtc
  timeUtc         String   // HH:mm derived from timeUtc
  dateTimeUtc     DateTime // full UTC timestamp — primary sort/index key
  period          DateTime? // Biquote's `period` field
  countryCode     String   // ISO alpha-2: US, EU, GB, JP, TR, ...
  currency        String   // USD, EUR, GBP, JPY, TRY, ...
  event           String   // event name: "Nonfarm Payrolls"
  impact          String   // high | medium | low
  eventType       String?  // indicator | holiday | speech | auction
  sector          String?  // jobs | inflation | ...
  unit            String?  // percent | currency | job | barrel | ...
  multiplier      String?  // thousands | millions | null
  digits          Int?
  actual          String?
  forecast        String?
  previous        String?
  revisedPrevious String?
  revision        Int?
  timeMode        String?  // exact | date | notime | tentative
  sourceUrl       String?
  source          String   // mql5 | (second feed)
  fetchedAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([dateTimeUtc])
  @@index([currency, date])
  @@index([impact, date])
  @@index([eventId])
  @@map("economic_events")
}