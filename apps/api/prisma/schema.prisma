generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String?
  firstName         String?
  lastName          String?
  emailVerified     Boolean   @default(false)
  verifyToken       String?   @unique
  verifyTokenExpiry DateTime?
  resetToken        String?   @unique
  resetTokenExpiry  DateTime?
  googleId          String?   @unique
  photoUrl          String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  role String @default("user")

  isBanned     Boolean   @default(false)
  bannedAt     DateTime?
  bannedReason String?
  bannedBy     String?

  lastLoginAt DateTime?

  tokenVersion Int @default(0)

  accounts      Account[]
  layouts       UserLayout[]
  strategies    Strategy[]
  conversations ConversationParticipant[]
  messages      Message[]

  @@index([role])
  @@index([isBanned])
  @@map("users")
}

model Account {
  id              String   @id @default(cuid())
  userId          String
  name            String
  balance         Float
  currency        String   @default("USD")
  type            String   @default("Backtest")
  riskType        String   @default("fixed")
  riskValue       Float?
  riskUnit        String?
  slValue         Float?
  slUnit          String?
  commissionMode  String   @default("none")
  commissionValue Float?
  columnConfigs   Json     @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades Trade[]

  @@index([userId])
  @@map("accounts")
}

model Trade {
  id         String  @id @default(cuid())
  accountId  String
  strategyId String?
  tradeId    String
  date       String
  entryTime  String
  exitTime   String
  direction  String
  symbol     String  @default("")

  mae      Float?
  mfe      Float?
  slPoints Float?

  entryPrice Float?
  takeProfit Float?
  stopLoss   Float?

  pnl       Float    @default(0)
  quantity  Float?
  notes     String   @default("")
  dynamic   Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account  Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  strategy Strategy? @relation(fields: [strategyId], references: [id], onDelete: SetNull)

  @@unique([accountId, tradeId])
  @@index([accountId])
  @@index([accountId, date])
  @@index([strategyId])
  @@map("trades")
}

model UserLayout {
  id        String   @id @default(cuid())
  userId    String
  name      String
  layout    Json
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_layouts")
}

model EconomicEvent {
  id              String    @id @default(cuid())
  externalId      String    @unique
  eventId         String?
  date            String
  timeUtc         String
  dateTimeUtc     DateTime
  period          DateTime?
  countryCode     String
  currency        String
  event           String
  impact          String
  eventType       String?
  sector          String?
  unit            String?
  multiplier      String?
  digits          Int?
  actual          String?
  forecast        String?
  previous        String?
  revisedPrevious String?
  revision        Int?
  timeMode        String?
  sourceUrl       String?
  source          String
  fetchedAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([dateTimeUtc])
  @@index([currency, date])
  @@index([impact, date])
  @@index([eventId])
  @@map("economic_events")
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actorEmail String
  action     String
  targetType String?
  targetId   String?
  metadata   Json     @default("{}")
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("site_settings")
}

// ---------------------------------------------------------------------------
// GEX / BL levels — one row per trading day.
//
// Design notes:
//   - `date` is a plain "YYYY-MM-DD" string. It represents the CALENDAR DAY
//     the levels are for (i.e. what the admin selected in the date picker).
//   - `levels` holds the canonical `[{ type, price, label }]` array.
//   - `converted` is the deterministic pipe-string built from `levels`.
//     It's stored so the user's "Copy" button returns EXACTLY what the admin
//     confirmed. The server re-serializes on POST and rejects mismatches.
//   - `blCount` / `gexCount` / `otherCount` denormalize the type breakdown
//     for the list view (avoids parsing the full `levels` array per row).
//   - `sourceTimezone` records which timezone the admin's date picker was
//     using when the row was created. Future site-wide TZ feature can query
//     this to migrate ambiguous dates.
//   - `uploadedBy` is a soft ref (String, no FK) — matching the audit-log
//     convention so a hard-deleted admin does not orphan their uploads.
// ---------------------------------------------------------------------------
model GexDay {
  id        String @id @default(cuid())
  date      String @unique
  levels    Json   @default("[]")
  converted String @default("")

  levelCount Int @default(0)
  blCount    Int @default(0)
  gexCount   Int @default(0)
  otherCount Int @default(0)

  sourceTimezone String @default("Asia/Kolkata")
  uploadedBy     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@map("gex_days")
}

// ---------------------------------------------------------------------------
// Strategy — a user-owned playbook.
//
// Design notes:
//   - One strategy name per user (`@@unique([userId, name])`).
//   - `status` is a plain string: "active" | "paused" | "archived". Validation
//     happens at the Zod layer, not the DB, so we don't need a migration to
//     add a new status later.
//   - `direction` is nullable: null means "both Long and Short", a value
//     means the strategy only applies to that direction.
//   - `color` is a hex string used to render the strategy chip / row accent.
//     The allowed palette is enforced in the shared validator.
//   - `tags` is a Postgres TEXT[] — array of free-form labels for grouping.
//   - Deleting a user cascades to their strategies. Deleting a strategy does
//     NOT cascade to trades: `Trade.strategyId` is `onDelete: SetNull`, so
//     trades keep running and just lose the tag.
// ---------------------------------------------------------------------------
model Strategy {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String   @default("")
  rules       String   @default("")
  status      String   @default("active")
  color       String   @default("#F59E0B")
  direction   String?
  timeframe   String?
  tags        String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades Trade[]

  @@unique([userId, name])
  @@index([userId])
  @@index([userId, status])
  @@map("strategies")
}

// ---------------------------------------------------------------------------
// Chat — Direct Messages (DMs) only. Discussions (public/private channels)
// will reuse these same tables with `type='channel'` in a future project.
//
// Design notes:
//   - `Conversation.dmKey` is a sorted "minUserId:maxUserId" string, unique,
//     that enforces one DM per pair of users at the DB level. Null for
//     future channels (which will use a `slug`).
//   - `ConversationParticipant` is the ONLY access-control check. Every
//     service call resolves the requesting user's row here before touching
//     the conversation. No admin route reads this table.
//   - `Message.deletedForIds` is per-user "delete for me". The read path
//     filters with `NOT: { deletedForIds: { has: userId } }`.
//   - `Message.deletedAt` is "delete for everyone" — soft-delete only. Body
//     retained in the DB, nulled out by the serializer on the wire.
//   - `Message.replyToId` is a self-FK, SetNull on delete.
//   - `unreadCount` on participant is incremented in the send transaction and
//     reset on markRead. Avoids a per-list count(*) query.
// ---------------------------------------------------------------------------
model Conversation {
  id              String   @id @default(cuid())
  type            String   @default("dm")
  dmKey           String?  @unique
  lastMessageAt   DateTime @default(now())
  lastMessageText String?
  lastMessageById String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]

  @@index([lastMessageAt])
  @@map("conversations")
}

model ConversationParticipant {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime @default(now())
  lastReadAt     DateTime @default(now())
  lastReadMsgId  String?
  unreadCount    Int      @default(0)
  isPinned       Boolean  @default(false)
  isMuted        Boolean  @default(false)
  isArchived     Boolean  @default(false)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, isArchived])
  @@index([userId, lastReadAt])
  @@map("conversation_participants")
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  replyToId      String?
  createdAt      DateTime  @default(now())
  editedAt       DateTime?
  deletedAt      DateTime?
  deletedForIds  String[]  @default([])

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo      Message?     @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Message[]    @relation("MessageReply")

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("messages")
}