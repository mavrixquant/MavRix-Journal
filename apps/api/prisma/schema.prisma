generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String?
  firstName         String?
  lastName          String?
  emailVerified     Boolean   @default(false)
  verifyToken       String?   @unique
  verifyTokenExpiry DateTime?
  resetToken        String?   @unique
  resetTokenExpiry  DateTime?
  googleId          String?   @unique
  photoUrl          String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  role String @default("user")

  isBanned     Boolean   @default(false)
  bannedAt     DateTime?
  bannedReason String?
  bannedBy     String?

  lastLoginAt DateTime?

  tokenVersion Int @default(0)

  accounts Account[]
  layouts  UserLayout[]

  @@index([role])
  @@index([isBanned])
  @@map("users")
}

model Account {
  id              String   @id @default(cuid())
  userId          String
  name            String
  balance         Float
  currency        String   @default("USD")
  type            String   @default("Backtest")
  riskType        String   @default("fixed")
  riskValue       Float?
  riskUnit        String?
  slValue         Float?
  slUnit          String?
  commissionMode  String   @default("none")
  commissionValue Float?
  columnConfigs   Json     @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades Trade[]

  @@index([userId])
  @@map("accounts")
}

model Trade {
  id        String @id @default(cuid())
  accountId String
  tradeId   String
  date      String
  entryTime String
  exitTime  String
  direction String
  symbol    String @default("")

  mae      Float?
  mfe      Float?
  slPoints Float?

  entryPrice Float?
  takeProfit Float?
  stopLoss   Float?

  pnl       Float    @default(0)
  quantity  Float?
  notes     String   @default("")
  dynamic   Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, tradeId])
  @@index([accountId])
  @@index([accountId, date])
  @@map("trades")
}

model UserLayout {
  id        String   @id @default(cuid())
  userId    String
  name      String
  layout    Json
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_layouts")
}

model EconomicEvent {
  id              String    @id @default(cuid())
  externalId      String    @unique
  eventId         String?
  date            String
  timeUtc         String
  dateTimeUtc     DateTime
  period          DateTime?
  countryCode     String
  currency        String
  event           String
  impact          String
  eventType       String?
  sector          String?
  unit            String?
  multiplier      String?
  digits          Int?
  actual          String?
  forecast        String?
  previous        String?
  revisedPrevious String?
  revision        Int?
  timeMode        String?
  sourceUrl       String?
  source          String
  fetchedAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([dateTimeUtc])
  @@index([currency, date])
  @@index([impact, date])
  @@index([eventId])
  @@map("economic_events")
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actorEmail String
  action     String
  targetType String?
  targetId   String?
  metadata   Json     @default("{}")
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("site_settings")
}

// ---------------------------------------------------------------------------
// GEX / BL levels — one row per trading day.
//
// Design notes:
//   - `date` is a plain "YYYY-MM-DD" string. It represents the CALENDAR DAY
//     the levels are for (i.e. what the admin selected in the date picker).
//   - `levels` holds the canonical `[{ type, price, label }]` array.
//   - `converted` is the deterministic pipe-string built from `levels`.
//     It's stored so the user's "Copy" button returns EXACTLY what the admin
//     confirmed. The server re-serializes on POST and rejects mismatches.
//   - `blCount` / `gexCount` / `otherCount` denormalize the type breakdown
//     for the list view (avoids parsing the full `levels` array per row).
//   - `sourceTimezone` records which timezone the admin's date picker was
//     using when the row was created. Future site-wide TZ feature can query
//     this to migrate ambiguous dates.
//   - `uploadedBy` is a soft ref (String, no FK) — matching the audit-log
//     convention so a hard-deleted admin does not orphan their uploads.
// ---------------------------------------------------------------------------
model GexDay {
  id         String   @id @default(cuid())
  date       String   @unique
  levels     Json     @default("[]")
  converted  String   @default("")

  levelCount Int @default(0)
  blCount    Int @default(0)
  gexCount   Int @default(0)
  otherCount Int @default(0)

  sourceTimezone String @default("Asia/Kolkata")
  uploadedBy     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@map("gex_days")
}