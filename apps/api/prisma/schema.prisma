generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String?
  firstName         String?
  lastName          String?
  emailVerified     Boolean   @default(false)
  verifyToken       String?   @unique
  verifyTokenExpiry DateTime?
  resetToken        String?
  resetTokenExpiry  DateTime?
  resetOtpAttempts  Int       @default(0)
  googleId          String?   @unique
  photoUrl          String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  role String @default("user")

  isBanned     Boolean   @default(false)
  bannedAt     DateTime?
  bannedReason String?
  bannedBy     String?

  lastLoginAt DateTime?

  tokenVersion Int @default(0)

  preferences Json @default("{}")

  isAi Boolean @default(false)

  // --- Two-Factor Authentication ---
  twoFactorEnabled        Boolean   @default(false)
  twoFactorEmailEnabled   Boolean   @default(false)
  twoFactorTotpEnabled    Boolean   @default(false)
  totpSecret              String?
  totpSecretIv            String?
  totpSecretTag           String?
  totpBackupCodes         Json      @default("[]")
  twoFactorVerifiedAt     DateTime?
  pendingTotpSecret       String?
  pendingTotpSecretIv     String?
  pendingTotpSecretTag    String?
  pendingEmailOtp         String?
  pendingEmailOtpExpiry   DateTime?
  pendingEmailOtpAttempts Int       @default(0)

  username String? @unique
  usernameChangedAt DateTime?

  accounts      Account[]
  layouts       UserLayout[]
  strategies    Strategy[]
  conversations ConversationParticipant[]
  messages      Message[]
  ownedGroups   Conversation[]            @relation("GroupOwner")

  friendshipsAsA     Friendship[]    @relation("FriendshipUserA")
  friendshipsAsB     Friendship[]    @relation("FriendshipUserB")
  friendRequestsSent FriendRequest[] @relation("FriendRequestFrom")
  friendRequestsRecv FriendRequest[] @relation("FriendRequestTo")
  blocksInitiated    UserBlock[]     @relation("UserBlockBlocker")
  blocksReceived     UserBlock[]     @relation("UserBlockBlocked")

  aiCredentials AiCredential[]

  bugReports BugReport[]

  @@index([role])
  @@index([isBanned])
  @@index([isAi])
  @@index([twoFactorEnabled])
  @@map("users")
}

model Account {
  id              String   @id @default(cuid())
  userId          String
  name            String
  balance         Float
  currency        String   @default("USD")
  type            String   @default("Backtest")
  riskType        String   @default("fixed")
  riskValue       Float?
  riskUnit        String?
  slValue         Float?
  slUnit          String?
  commissionMode  String   @default("none")
  commissionValue Float?
  columnConfigs   Json     @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades Trade[]

  @@index([userId])
  @@map("accounts")
}

model Trade {
  id         String  @id @default(cuid())
  accountId  String
  strategyId String?
  tradeId    String
  date       String
  entryTime  String
  exitTime   String
  direction  String
  symbol     String  @default("")

  mae      Float?
  mfe      Float?
  slPoints Float?

  entryPrice Float?
  takeProfit Float?
  stopLoss   Float?

  pnl       Float    @default(0)
  quantity  Float?
  notes     String   @default("")
  dynamic   Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account  Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  strategy Strategy? @relation(fields: [strategyId], references: [id], onDelete: SetNull)

  @@unique([accountId, tradeId])
  @@index([accountId])
  @@index([accountId, date])
  @@index([strategyId])
  @@map("trades")
}

model UserLayout {
  id        String   @id @default(cuid())
  userId    String
  name      String
  layout    Json
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_layouts")
}

model EconomicEvent {
  id              String    @id @default(cuid())
  externalId      String    @unique
  eventId         String?
  date            String
  timeUtc         String
  dateTimeUtc     DateTime
  period          DateTime?
  countryCode     String
  currency        String
  event           String
  impact          String
  eventType       String?
  sector          String?
  unit            String?
  multiplier      String?
  digits          Int?
  actual          String?
  forecast        String?
  previous        String?
  revisedPrevious String?
  revision        Int?
  timeMode        String?
  sourceUrl       String?
  source          String
  fetchedAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([dateTimeUtc])
  @@index([currency, date])
  @@index([impact, date])
  @@index([eventId])
  @@map("economic_events")
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actorEmail String
  action     String
  targetType String?
  targetId   String?
  metadata   Json     @default("{}")
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("site_settings")
}

model GexDay {
  id        String @id @default(cuid())
  date      String
  symbol    String @default("NQ")
  levels    Json   @default("[]")
  converted String @default("")

  levelCount Int @default(0)
  blCount    Int @default(0)
  gexCount   Int @default(0)
  otherCount Int @default(0)

  sourceTimezone String @default("Asia/Kolkata")
  uploadedBy     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date, symbol])
  @@index([symbol, date])
  @@map("gex_days")
}

model Strategy {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String   @default("")
  rules       String   @default("")
  status      String   @default("active")
  color       String   @default("#F59E0B")
  direction   String?
  timeframe   String?
  tags        String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades Trade[]

  @@unique([userId, name])
  @@index([userId])
  @@index([userId, status])
  @@map("strategies")
}

model Conversation {
  id              String   @id @default(cuid())
  type            String   @default("dm")
  dmKey           String?  @unique
  lastMessageAt   DateTime @default(now())
  lastMessageText String?
  lastMessageById String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  name        String?
  description String?
  visibility  String?
  color       String? @default("#F59E0B")
  iconEmoji   String?
  createdById String?
  memberCount Int     @default(2)

  createdBy User? @relation("GroupOwner", fields: [createdById], references: [id], onDelete: SetNull)

  participants ConversationParticipant[]
  messages     Message[]

  @@index([lastMessageAt])
  @@index([type, visibility])
  @@map("conversations")
}

model ConversationParticipant {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime @default(now())
  lastReadAt     DateTime @default(now())
  lastReadMsgId  String?
  unreadCount    Int      @default(0)
  isPinned       Boolean  @default(false)
  isMuted        Boolean  @default(false)
  isArchived     Boolean  @default(false)

  role String @default("member")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, isArchived])
  @@index([userId, lastReadAt])
  @@index([conversationId, role])
  @@map("conversation_participants")
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  body           String

  kind           String    @default("user")

  replyToId      String?
  createdAt      DateTime  @default(now())
  editedAt       DateTime?
  deletedAt      DateTime?
  deletedForIds  String[]  @default([])
  deliveredAt    DateTime?
  readAt         DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo      Message?     @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Message[]    @relation("MessageReply")

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([conversationId, senderId])
  @@map("messages")
}

model Friendship {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  createdAt DateTime @default(now())

  userA User @relation("FriendshipUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("FriendshipUserB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
  @@map("friendships")
}

model FriendRequest {
  id          String    @id @default(cuid())
  fromUserId  String
  toUserId    String
  message     String?
  status      String    @default("pending")
  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  fromUser User @relation("FriendRequestFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("FriendRequestTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([fromUserId])
  @@index([toUserId])
  @@index([toUserId, status])
  @@index([fromUserId, status])
  @@map("friend_requests")
}

model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  reason    String?
  createdAt DateTime @default(now())

  blocker User @relation("UserBlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("UserBlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
  @@map("user_blocks")
}

model AiCredential {
  id           String   @id @default(cuid())
  userId       String
  provider     String
  encryptedKey String
  keyIv        String
  keyTag       String
  model        String?
  models       Json     @default("[]")
  lastUsedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
  @@map("ai_credentials")
}

// ---------------------------------------------------------------------------
// BugReport â€” in-app bug reports.
//
// The report itself is stored here for admin review; an optional screenshot
// is NEVER persisted â€” it is attached only to the email that goes out to
// SUPPORT_EMAIL. Text only lives here.
// ---------------------------------------------------------------------------
model BugReport {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String
  category    String   @default("bug")
  severity    String   @default("medium")
  status      String   @default("open")
  pageUrl     String?
  userAgent   String?
  adminNote   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt])
  @@map("bug_reports")
}