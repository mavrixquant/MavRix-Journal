generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String?
  firstName         String?
  lastName          String?
  emailVerified     Boolean   @default(false)
  verifyToken       String?   @unique
  verifyTokenExpiry DateTime?
  resetToken        String?   @unique
  resetTokenExpiry  DateTime?
  googleId          String?   @unique
  photoUrl          String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  role String @default("user")

  isBanned     Boolean   @default(false)
  bannedAt     DateTime?
  bannedReason String?
  bannedBy     String?

  lastLoginAt DateTime?

  tokenVersion Int @default(0)

  preferences Json @default("{}")

  // Mave AI sentinel. Exactly one user has isAi = true (the built-in
  // assistant). Enforced at the service layer — see maveAiBootstrap.js.
  isAi Boolean @default(false)

  accounts      Account[]
  layouts       UserLayout[]
  strategies    Strategy[]
  conversations ConversationParticipant[]
  messages      Message[]
  ownedGroups   Conversation[]            @relation("GroupOwner")

  // ---------------------------------------------------------------------------
  // Friends subsystem
  //
  // Friendship      — one row per accepted pair. Stored canonically as
  //                   (userAId, userBId) with userAId < userBId
  //                   lexicographically. The composite unique key guarantees
  //                   a single friendship row per pair regardless of who
  //                   sent the request.
  //
  // FriendRequest   — directed from → to. `status` is one of:
  //                     'pending'   — awaiting response
  //                     'accepted'  — (kept for audit trail)
  //                     'declined'  — recipient said no
  //                     'cancelled' — sender withdrew
  //                   Only ONE pending request may exist per directed pair;
  //                   this is enforced at the service layer.
  //
  // UserBlock       — directed blocker → blocked. Presence of either
  //                   direction hides the pair from each other entirely.
  // ---------------------------------------------------------------------------
  friendshipsAsA     Friendship[]    @relation("FriendshipUserA")
  friendshipsAsB     Friendship[]    @relation("FriendshipUserB")
  friendRequestsSent FriendRequest[] @relation("FriendRequestFrom")
  friendRequestsRecv FriendRequest[] @relation("FriendRequestTo")
  blocksInitiated    UserBlock[]     @relation("UserBlockBlocker")
  blocksReceived     UserBlock[]     @relation("UserBlockBlocked")

  // Per-user BYOK credentials for Mave AI. One row per (userId, provider).
  // The router rotates across all of a user's credentials using lastUsedAt
  // as the LRU driver.
  aiCredentials AiCredential[]

  @@index([role])
  @@index([isBanned])
  @@index([isAi])
  @@map("users")
}

model Account {
  id              String   @id @default(cuid())
  userId          String
  name            String
  balance         Float
  currency        String   @default("USD")
  type            String   @default("Backtest")
  riskType        String   @default("fixed")
  riskValue       Float?
  riskUnit        String?
  slValue         Float?
  slUnit          String?
  commissionMode  String   @default("none")
  commissionValue Float?
  columnConfigs   Json     @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades Trade[]

  @@index([userId])
  @@map("accounts")
}

model Trade {
  id         String  @id @default(cuid())
  accountId  String
  strategyId String?
  tradeId    String
  date       String
  entryTime  String
  exitTime   String
  direction  String
  symbol     String  @default("")

  mae      Float?
  mfe      Float?
  slPoints Float?

  entryPrice Float?
  takeProfit Float?
  stopLoss   Float?

  pnl       Float    @default(0)
  quantity  Float?
  notes     String   @default("")
  dynamic   Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account  Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  strategy Strategy? @relation(fields: [strategyId], references: [id], onDelete: SetNull)

  @@unique([accountId, tradeId])
  @@index([accountId])
  @@index([accountId, date])
  @@index([strategyId])
  @@map("trades")
}

model UserLayout {
  id        String   @id @default(cuid())
  userId    String
  name      String
  layout    Json
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_layouts")
}

model EconomicEvent {
  id              String    @id @default(cuid())
  externalId      String    @unique
  eventId         String?
  date            String
  timeUtc         String
  dateTimeUtc     DateTime
  period          DateTime?
  countryCode     String
  currency        String
  event           String
  impact          String
  eventType       String?
  sector          String?
  unit            String?
  multiplier      String?
  digits          Int?
  actual          String?
  forecast        String?
  previous        String?
  revisedPrevious String?
  revision        Int?
  timeMode        String?
  sourceUrl       String?
  source          String
  fetchedAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([dateTimeUtc])
  @@index([currency, date])
  @@index([impact, date])
  @@index([eventId])
  @@map("economic_events")
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actorEmail String
  action     String
  targetType String?
  targetId   String?
  metadata   Json     @default("{}")
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("site_settings")
}

model GexDay {
  id        String @id @default(cuid())
  date      String @unique
  levels    Json   @default("[]")
  converted String @default("")

  levelCount Int @default(0)
  blCount    Int @default(0)
  gexCount   Int @default(0)
  otherCount Int @default(0)

  sourceTimezone String @default("Asia/Kolkata")
  uploadedBy     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@map("gex_days")
}

model Strategy {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String   @default("")
  rules       String   @default("")
  status      String   @default("active")
  color       String   @default("#F59E0B")
  direction   String?
  timeframe   String?
  tags        String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades Trade[]

  @@unique([userId, name])
  @@index([userId])
  @@index([userId, status])
  @@map("strategies")
}

// ---------------------------------------------------------------------------
// Chat — Direct Messages + Groups.
//
// One Conversation row per DM or per group. The `type` column distinguishes
// them:
//
//   type='dm'    → dmKey = sorted "aId:bId" (unique). Group columns null.
//   type='group' → dmKey = null. Group columns populated.
//
// Read receipts:
//   - Message.deliveredAt — set by the non-sender's device when it receives
//     the message (either via POST /messages/:id/delivered for live SSE
//     delivery, or in bulk by markRead on thread open).
//   - Message.readAt — set when the non-sender opens the conversation
//     (markRead). Also triggers a broadcast to the sender.
//
// Both columns are nullable. For a fresh conversation, they're null until
// the peer's device acknowledges.
//
// Group-specific columns on Conversation:
//   name         — display name (# header)
//   description  — short blurb shown in discovery + settings
//   visibility   — 'public' | 'private' | null (null = DM)
//   color        — accent for the avatar + name chip
//   iconEmoji    — optional emoji shown inside the avatar circle
//   createdById  — FK to User. Null for DMs.
//   memberCount  — denormalized participant count. Kept in sync inside the
//                  same transaction as every membership change.
//
// Group-specific columns on ConversationParticipant:
//   role         — 'owner' | 'moderator' | 'member'. Default 'member'.
//                  DMs leave this at 'member'.
//
// Mave AI DMs are ordinary `type='dm'` rows. The only distinguishing feature
// is that the peer (User.isAi === true) is the built-in assistant.
// ---------------------------------------------------------------------------
model Conversation {
  id              String   @id @default(cuid())
  type            String   @default("dm")
  dmKey           String?  @unique
  lastMessageAt   DateTime @default(now())
  lastMessageText String?
  lastMessageById String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Group-only metadata. All nullable so existing DMs are unaffected.
  name        String?
  description String?
  visibility  String? // 'public' | 'private' | null (DM)
  color       String? @default("#F59E0B")
  iconEmoji   String?
  createdById String?
  memberCount Int     @default(2)

  createdBy User? @relation("GroupOwner", fields: [createdById], references: [id], onDelete: SetNull)

  participants ConversationParticipant[]
  messages     Message[]

  @@index([lastMessageAt])
  @@index([type, visibility])
  @@map("conversations")
}

model ConversationParticipant {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime @default(now())
  lastReadAt     DateTime @default(now())
  lastReadMsgId  String?
  unreadCount    Int      @default(0)
  isPinned       Boolean  @default(false)
  isMuted        Boolean  @default(false)
  isArchived     Boolean  @default(false)

  // 'owner' | 'moderator' | 'member'. DMs leave this at 'member'.
  role String @default("member")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, isArchived])
  @@index([userId, lastReadAt])
  @@index([conversationId, role])
  @@map("conversation_participants")
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  body           String

  // 'user'      — normal message written by a human
  // 'system'    — inline system notice (e.g. "Mave AI is cooling down")
  // 'ai_switch' — inline notice explaining a provider switch
  // All kinds render inside the thread; the UI treats them differently.
  kind           String    @default("user")

  replyToId      String?
  createdAt      DateTime  @default(now())
  editedAt       DateTime?
  deletedAt      DateTime?
  deletedForIds  String[]  @default([])
  deliveredAt    DateTime?
  readAt         DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo      Message?     @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Message[]    @relation("MessageReply")

  @@index([conversationId, createdAt])
  @@index([senderId])
  // Powers the "how many messages has user X sent in conversation Y?" query
  // used by the friend-required 3-message cap on non-friend DMs.
  @@index([conversationId, senderId])
  @@map("messages")
}

// ---------------------------------------------------------------------------
// Friendships — accepted pairs.
//
// Canonical form: userAId is ALWAYS lexicographically smaller than userBId.
// The service layer sorts ids before writing. This means a single row exists
// per friendship regardless of who initiated the request.
//
// Uniqueness: composite key on (userAId, userBId). Combined with the sort
// invariant, this is effectively "one friendship per pair".
// ---------------------------------------------------------------------------
model Friendship {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  createdAt DateTime @default(now())

  userA User @relation("FriendshipUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("FriendshipUserB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
  @@map("friendships")
}

// ---------------------------------------------------------------------------
// Friend requests — directed, from sender to recipient.
//
// `status` is a plain string (not a Prisma enum) to match the codebase's
// existing style (Conversation.type, Account.type, etc. all use strings).
//
// Lifecycle:
//   pending  → accepted  (creates a Friendship row in the same transaction)
//   pending  → declined  (recipient action)
//   pending  → cancelled (sender withdrew)
//
// Only one PENDING request may exist per directed pair. Enforced in the
// service layer, not the DB (a partial unique index would be Postgres-
// specific and Prisma doesn't support partial unique constraints yet).
// ---------------------------------------------------------------------------
model FriendRequest {
  id          String    @id @default(cuid())
  fromUserId  String
  toUserId    String
  message     String?
  status      String    @default("pending")
  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  fromUser User @relation("FriendRequestFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("FriendRequestTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([fromUserId])
  @@index([toUserId])
  @@index([toUserId, status])
  @@index([fromUserId, status])
  @@map("friend_requests")
}

// ---------------------------------------------------------------------------
// User blocks — directed. Presence of EITHER direction between two users
// means they can't see each other in search, in friend lists, in group
// member cards, or DM each other.
//
// On block creation (service layer, single transaction):
//   1. DELETE any Friendship between the pair (both sort orders).
//   2. UPDATE any pending FriendRequest (either direction) → 'cancelled'.
//   3. INSERT the UserBlock row.
//
// On unblock: only the UserBlock row is deleted. The friendship is NOT
// restored — the pair must re-send and re-accept a friend request.
// ---------------------------------------------------------------------------
model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  reason    String?
  createdAt DateTime @default(now())

  blocker User @relation("UserBlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("UserBlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
  @@map("user_blocks")
}

// ---------------------------------------------------------------------------
// AiCredential — BYOK credentials for Mave AI.
//
// ONE ROW PER (userId, provider). The router lists every row for a user
// ordered by `lastUsedAt` (nulls first) and tries each credential's
// `models[]` in sequence until one succeeds.
//
// Encryption: AES-256-GCM with MAVE_AI_MASTER_KEY. The three hex columns
// below must all be present to decrypt.
//
//   models[]    — ordered list of chat models for this credential. Populated
//                 by discoverModels() at save time; falls back to the curated
//                 list from @mavrix/shared on discovery failure.
//   lastUsedAt  — LRU rotation driver. NULL means never used → first.
//   model       — legacy "primary model" override. Still respected if
//                 models[] is empty (backward compat for pre-migration rows).
// ---------------------------------------------------------------------------
model AiCredential {
  id           String   @id @default(cuid())
  userId       String
  provider     String   // 'openrouter' | 'openai' | 'anthropic' | 'gemini' | 'groq' | 'deepseek'
  encryptedKey String   // hex ciphertext
  keyIv        String   // hex IV (12 bytes)
  keyTag       String   // hex GCM tag (16 bytes)
  model        String?  // legacy primary model override
  models       Json     @default("[]")  // ordered list of chat models
  lastUsedAt   DateTime?                // LRU rotation driver
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
  @@map("ai_credentials")
}