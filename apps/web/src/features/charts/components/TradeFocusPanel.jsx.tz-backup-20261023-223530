export default function TradeFocusPanel({
  trades,
  symbol,
  activeTs,
  onFocus,
  displayTz,
  displayOffset = 0,
}) {
  const sorted = useMemo(() => {
    return [...trades].sort((a, b) => {
      const da = `${a.date || ''}T${a.entryTime || ''}`;
      const db = `${b.date || ''}T${b.entryTime || ''}`;
      return db.localeCompare(da);
    });
  }, [trades]);

  return (
    <>
      <style>{CSS}</style>
      <aside className="tfp-root">
        <div className="tfp-head">
          <TrendingUp size={12} style={{ color: 'var(--accent)' }} />
          <span className="tfp-title">Trades</span>
          <span className="tfp-symbol">{symbol}</span>
          <span className="tfp-count">{sorted.length}</span>
        </div>

        {sorted.length === 0 ? (
          <div className="tfp-empty">
            <div className="tfp-empty-icon">
              <Crosshair size={16} />
            </div>
            <span>No journal trades on <b style={{ color: 'var(--accent)' }}>{symbol}</b> yet.</span>
            <span style={{ opacity: .7, fontSize: 10.5 }}>
              Log a Live / Demo trade with this symbol and it will show up here.
            </span>
          </div>
        ) : (
          <div className="tfp-list">
            {sorted.map((t) => {
              const rawUtc = tradeTimeToUtcSeconds(t.date, t.entryTime, displayTz);
              const isLong = String(t.direction || '').toLowerCase() === 'long';
              const net = (Number(t.pnl) || 0) - (Number(t.commission) || 0);
              const cls = net > 0 ? 'pos' : net < 0 ? 'neg' : 'flat';
              const displayTs = rawUtc != null ? rawUtc + displayOffset : null;

              return (
                <button
                  key={t.id || `${t.date}-${t.entryTime}`}
                  type="button"
                  className={`tfp-row${isActive ? ' is-active' : ''}`}
                  onClick={() => { if (displayTs != null) onFocus(displayTs); }}
                  title={`Focus chart on ${t.date} ${t.entryTime}`}
                >
                  <div className="tfp-row-top">
                    <span className="tfp-row-date">{fmtDate(t.date)}</span>
                    <span className={`tfp-row-dir ${isLong ? 'is-long' : 'is-short'}`}>
                      {isLong ? 'Long' : 'Short'}
                    </span>
                  </div>
                  <div className="tfp-row-bottom">
                    <span className="tfp-row-time">{t.entryTime}</span>
                    <span className={`tfp-row-pnl ${cls}`}>
                      {fmtMoney(net, t.currency || 'USD')}
                    </span>
                  </div>
                </button>
              );
            })}
          </div>
        )}
      </aside>
    </>
  );
}